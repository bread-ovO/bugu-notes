{
  "manifest_version": 3,
  "name": "BUGU 不咕 · 事件桥接",
  "version": "0.1.0",
  "description": "将明确授权站点中正在查看的对象标识发送给本机 BUGU；不读取页面正文、Cookie 或浏览历史。",
  "permissions": ["nativeMessaging", "storage", "scripting"],
  "optional_host_permissions": [
    "https://github.com/*",
    "https://*.feishu.cn/*",
    "https://*.larksuite.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "options.html"
  },
  "options_page": "options.html",
  "key": ""
}
